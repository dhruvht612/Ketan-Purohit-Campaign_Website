# Copy to `.env` and fill in to enable live integrations.
# (Local `vite dev` does not run /api routes — deploy to Vercel to exercise them.)

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=

# --- Email confirmations (e.g. Resend / SendGrid / Postmark) ---
EMAIL_API_KEY=

# --- Datastore (e.g. Supabase / Postgres connection string) ---
DATABASE_URL=
